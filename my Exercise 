using System;

class CourseResult
{
    
    private double mark;

    // StudentName  (Auto-implemented property)
    public string StudentName { get; set; }

    public double Mark
    {
        get { return mark; }
        set
        {
            if (value >= 0 && value <= 100)
            {
                mark = value;
            }
            else
            {
                Console.WriteLine("Error: Mark must be between 0 and 100.");
            }
        }
    }

      public string Grade
    {
        get
        {
            if (mark >= 90) return "A";
            if (mark >= 80) return "B";
            if (mark >= 70) return "C";
            if (mark >= 60) return "D";
            return "F";
        }
    }

     
    public bool Passed
    {
        get { return mark >= 50; }
    }

   
    public void PrintResult()
    {
        Console.WriteLine($"Student Name: {StudentName}");
        Console.WriteLine($"Mark: {Mark}");
        Console.WriteLine($"Grade: {Grade}");
        Console.WriteLine($"Passed: {Passed}");
    }
}
class Program
{
    static void Main(string[] args)
    {
        CourseResult result = new CourseResult();

         
        Console.Write("Enter student name: ");
        result.StudentName = Console.ReadLine();

        
        Console.WriteLine("\n--- Testing Invalid Mark (150) ---");
        result.Mark = 150;

         
        Console.Write("\nEnter a valid mark (0-100): ");
        if (double.TryParse(Console.ReadLine(), out double userMark))
        {
            result.Mark = userMark;
        }

        
        Console.WriteLine("\n--- Final Course Result ---");
        result.PrintResult();
    }
}
